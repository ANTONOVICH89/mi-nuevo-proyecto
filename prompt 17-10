Java.perform(function() {
    var Request = Java.use('okhttp3.Request');
    Request.url.overload().implementation = function() {
        var url = this.url().toString();
        if (url.indexOf('portalCore') !== -1) {
            console.log('\n=== OKHTTP REQUEST ===');
